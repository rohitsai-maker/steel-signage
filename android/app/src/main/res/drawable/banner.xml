<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320x180dp). Replace with a PNG of your logo for a nicer look. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1E3A8A" android:endColor="#4F8CFF" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher" android:gravity="center" android:width="96dp" android:height="96dp" />
</layer-list>
